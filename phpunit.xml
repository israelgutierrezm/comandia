<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Reglas estructurales: scopes de tenant (ADR-002) y fronteras de módulos. -->
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <!--
            Concurrencia REAL: dos conexiones distintas peleando por la misma fila.

            Suite aparte porque `RefreshDatabase` envuelve cada prueba en una transacción, y una
            transacción hace invisibles los datos para cualquier otra conexión. O sea que la
            herramienta que aísla las pruebas es la que impide probar la concurrencia: sin esta
            suite, el lock del kardex no se puede verificar de verdad y quedaría en «confío en que
            MySQL bloquea».

            Estas pruebas hacen COMMIT y limpian lo suyo a mano.
        -->
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            La suite completa NO cabe en los 128 MB por omisión de PHP.

            Reventó al llegar a ~890 pruebas, con `Allowed memory size exhausted` y, lo peor, ABORTANDO la corrida
            completa en lugar de fallar una prueba: el mismo síntoma que un ayudante duplicado (D191), donde el archivo
            corriendo solo pasa en verde y la suite entera muere. Antes de subir el límite se corrigió un candado que
            concatenaba todo `app/` en una cadena, pero el techo se alcanzaba igual — no es un derroche puntual, es el
            tamaño del proyecto.

            512M y no «sin límite»: un límite alto sigue avisando de una fuga real, y `-1` la esconde para siempre.
        -->
        <ini name="memory_limit" value="512M"/>

        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>

        <!-- Cache y sesión en memoria: aisladas entre tests, sin dependencia de Redis. -->
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>

        <!--
            MySQL 8 real, base dedicada. NO SQLite: ver la justificación en
            tests/Pest.php y la decisión D60 del registro.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="comandia_testing"/>
        <env name="DB_URL" value=""/>

        <!--
            Colas en `sync` por defecto: cada test que verifique procesamiento
            asíncrono real (idempotencia de jobs, drenado de cola al cerrar
            sesión de caja) declara explícitamente lo contrario. Un test que
            depende de un worker externo no es reproducible.
        -->
        <env name="QUEUE_CONNECTION" value="sync"/>

        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
