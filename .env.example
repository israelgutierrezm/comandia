###############################################################################
# Comandia — plantilla de entorno (forma canónica del proyecto)
#
# Los valores de este archivo son la CONFIGURACIÓN OBJETIVO del proyecto
# (ARQUITECTURA_MAESTRA §12): MySQL 8 InnoDB + Redis para cache y colas.
# Si tu máquina local no puede satisfacerlos todavía, consulta
# docs/ENTORNO_LOCAL.md — pero no cambies esta plantilla.
###############################################################################

APP_NAME=Comandia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

#------------------------------------------------------------------------------
# Sanctum — dominios con sesión (SPA de administración)
#
# La SPA se autentica por COOKIE, no por token, y Sanctum sólo acepta la cookie
# si el host:puerto que sirve la aplicación está declarado aquí. El modo de falla
# no se parece a un problema de configuración: la sesión funciona, el shell de
# Inertia carga, y TODA /api/v1 responde 401. Se descubrió sirviendo en un puerto
# distinto al de APP_URL.
#
# Si sirves en otro puerto, agrégalo a esta lista. Hay un test que verifica que el
# host de APP_URL esté cubierto (tests/Feature/FoundationSmokeTest.php).
#------------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

# Almacenamiento en UTC siempre; la presentación usa la zona horaria de la
# sucursal (ARQUITECTURA_MAESTRA §7). No cambiar APP_TIMEZONE.
APP_TIMEZONE=UTC

# Mercado México exclusivamente en v1 (ESPECIFICACION_MAESTRA §2).
APP_LOCALE=es_MX
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#------------------------------------------------------------------------------
# Base de datos — MySQL 8 con InnoDB forzado en config/database.php
#------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=comandia
DB_USERNAME=root
DB_PASSWORD=

# Base usada por la suite de pruebas (ver phpunit.xml). Debe existir.
DB_TEST_DATABASE=comandia_testing

#------------------------------------------------------------------------------
# Sesión, cache y colas — Redis (ARQUITECTURA_MAESTRA §12)
#------------------------------------------------------------------------------
SESSION_DRIVER=redis
# Base 2 de Redis: las sesiones no comparten espacio con las colas ni la cache.
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
# CACHE_PREFIX=

QUEUE_CONNECTION=redis
# Cola por defecto cuando un job no declara la suya. Las cuatro colas del
# proyecto (critical, default, exports, printing) están declaradas en
# config/comandia.php y se sirven con:
#   php artisan queue:work redis --queue=critical,default,exports,printing
REDIS_QUEUE=default

# Sin extensión phpredis en Windows/WampServer: se usa el cliente PHP puro.
# En el VPS de producción se recomienda phpredis por rendimiento.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#------------------------------------------------------------------------------
# Tiempo real — Reverb (se configura en la Iteración 6)
#------------------------------------------------------------------------------

#------------------------------------------------------------------------------
# Archivos y correo
#------------------------------------------------------------------------------
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@comandia.mx"
MAIL_FROM_NAME="${APP_NAME}"

#------------------------------------------------------------------------------
# Frontend
#------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ---- Tiempo real (Reverb, Iteración 5) ----
#
# La difusión va por COLA (`critical`), asi que en desarrollo, SIN `queue:work`, nada llega por socket: el piso se
# mantiene al día con su respaldo de sondeo. Es deliberado — un Reverb caído no puede tumbar un cobro.
#
# El servidor se levanta aparte:  php artisan reverb:start
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=100001
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
